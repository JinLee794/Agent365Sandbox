{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OAuth 2.0 Token Acquisition",
  "description": "Authentication contracts for obtaining access tokens via OAuth 2.0 client credentials flow",
  "version": "1.0.0",

  "endpoints": {
    "acquireToken": {
      "method": "POST",
      "path": "/oauth2/v2.0/token",
      "baseUrl": "https://login.microsoftonline.com/{tenant_id}",
      "description": "Obtain an access token using client credentials flow",
      "headers": {
        "Content-Type": "application/x-www-form-urlencoded"
      },
      "requestBody": {
        "$ref": "#/definitions/TokenRequest"
      },
      "responses": {
        "200": {
          "description": "Token acquired successfully",
          "schema": {
            "$ref": "#/definitions/TokenResponse"
          }
        },
        "400": {
          "description": "Bad request - invalid credentials or parameters",
          "schema": {
            "$ref": "#/definitions/TokenError"
          }
        },
        "401": {
          "description": "Unauthorized - invalid client credentials",
          "schema": {
            "$ref": "#/definitions/TokenError"
          }
        }
      }
    }
  },

  "definitions": {
    "TokenRequest": {
      "type": "object",
      "description": "Form-encoded request body for token acquisition",
      "required": ["client_id", "client_secret", "scope", "grant_type"],
      "properties": {
        "client_id": {
          "type": "string",
          "format": "uuid",
          "description": "Application (client) ID from Azure App Registration",
          "example": "aaaabbbb-1111-2222-3333-ccccddddeeee"
        },
        "client_secret": {
          "type": "string",
          "description": "Client secret from Azure App Registration (treat as sensitive)",
          "example": "your_client_secret_here"
        },
        "scope": {
          "type": "string",
          "description": "Requested permission scope (use .default for all configured permissions)",
          "example": "https://graph.microsoft.com/.default"
        },
        "grant_type": {
          "type": "string",
          "enum": ["client_credentials"],
          "description": "OAuth 2.0 grant type - must be 'client_credentials'",
          "example": "client_credentials"
        },
        "tenant_id": {
          "type": "string",
          "format": "uuid",
          "description": "Azure AD tenant ID (used in URL, not body)",
          "example": "tttttttt-1111-2222-3333-tttttttttttt"
        }
      }
    },

    "TokenResponse": {
      "type": "object",
      "properties": {
        "access_token": {
          "type": "string",
          "description": "JWT access token - use in Authorization header",
          "example": "eyJ0eXAiOiJKV1QiLCJhbGciOiJSUzI1NiIsImtpZCI6..."
        },
        "token_type": {
          "type": "string",
          "enum": ["Bearer"],
          "description": "Token type - always 'Bearer' for OAuth 2.0",
          "example": "Bearer"
        },
        "expires_in": {
          "type": "integer",
          "description": "Token lifetime in seconds (typically 3600 = 1 hour)",
          "example": 3600
        },
        "ext_expires_in": {
          "type": "integer",
          "description": "Extended expiration for resiliency",
          "example": 3600
        },
        "scope": {
          "type": "string",
          "description": "Granted scopes",
          "example": "https://graph.microsoft.com/.default"
        }
      }
    },

    "TokenError": {
      "type": "object",
      "properties": {
        "error": {
          "type": "string",
          "description": "Error code",
          "example": "invalid_client"
        },
        "error_description": {
          "type": "string",
          "description": "Human-readable error message",
          "example": "AADSTS7000215: Invalid client secret provided."
        },
        "error_codes": {
          "type": "array",
          "items": {"type": "integer"},
          "description": "Azure AD specific error codes"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time",
          "description": "Error occurrence timestamp"
        },
        "trace_id": {
          "type": "string",
          "description": "Correlation ID for troubleshooting"
        },
        "correlation_id": {
          "type": "string",
          "format": "uuid",
          "description": "Request correlation ID"
        }
      }
    }
  },

  "exampleRequests": {
    "acquireGraphToken": {
      "description": "Example: Acquire token for Microsoft Graph API",
      "request": {
        "method": "POST",
        "url": "https://login.microsoftonline.com/tttttttt-1111-2222-3333-tttttttttttt/oauth2/v2.0/token",
        "headers": {
          "Content-Type": "application/x-www-form-urlencoded"
        },
        "body": "client_id=aaaabbbb-1111-2222-3333-ccccddddeeee&client_secret=YOUR_SECRET&scope=https://graph.microsoft.com/.default&grant_type=client_credentials"
      },
      "response": {
        "status": 200,
        "body": {
          "access_token": "eyJ0eXAiOiJKV1QiLCJhbGciOiJSUzI1NiIsImtpZCI6...",
          "token_type": "Bearer",
          "expires_in": 3600,
          "ext_expires_in": 3600,
          "scope": "https://graph.microsoft.com/.default"
        }
      }
    },

    "pythonExample": {
      "description": "Python code example using requests library",
      "code": "import requests\n\ntoken_url = f'https://login.microsoftonline.com/{tenant_id}/oauth2/v2.0/token'\ntoken_data = {\n    'client_id': client_id,\n    'client_secret': client_secret,\n    'scope': 'https://graph.microsoft.com/.default',\n    'grant_type': 'client_credentials'\n}\n\nresponse = requests.post(token_url, data=token_data)\ntoken_response = response.json()\naccess_token = token_response['access_token']"
    }
  },

  "securityNotes": [
    "Never hardcode client_secret in notebooks - use environment variables",
    "Never commit .env files with actual secrets to version control",
    "Tokens are sensitive - do not print or log in notebook output",
    "Use .env.example as a template with placeholder values only",
    "Token lifetime is 1 hour - re-authenticate if cells fail with 401 errors"
  ]
}
